{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FP frontmatter",
  "type": "object",
  "required": ["fp", "title", "type", "authors", "created", "defines", "supersedes"],
  "additionalProperties": false,
  "properties": {
    "fp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!FP-[0-9]{4}:).+"
    },
    "type": {
      "type": "string",
      "enum": ["Feature", "Governance"]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 39,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(?![\\s\\S])"
      }
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "defines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FP-[0-9]{4}$"
      }
    }
  }
}
